# 新獨立 VPS：為 Let's Encrypt HTTP-01 webroot 驗證提供 80 埠入口。
# 要先建立 /var/www/letsencrypt/.well-known/acme-challenge 目錄。
# certbot certonly --webroot -w /var/www/letsencrypt -d v2-hall-direct.myxingbei.com
server {
    listen 80;
    server_name v2-hall-direct.myxingbei.com;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/letsencrypt;
        default_type text/plain;
    }
    location / {
        return 404;
    }
}
