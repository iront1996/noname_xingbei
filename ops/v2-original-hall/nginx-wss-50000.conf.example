# 新獨立 VPS：僅在憑證存在、DNS 已設為 DNS only、8080 已由防火牆阻擋公網後啟用。
# 本檔應放置在 nginx http {} 內（如 sites-enabled）。不要修改其他站台的設定。
server {
    listen 50000 ssl;
    server_name v2-hall-direct.myxingbei.com;

    ssl_certificate /etc/letsencrypt/live/v2-hall-direct.myxingbei.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/v2-hall-direct.myxingbei.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    access_log /var/log/nginx/v2-original-hall-access.log combined;
    error_log /var/log/nginx/v2-original-hall-error.log warn;

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;

        proxy_connect_timeout 5s;
        proxy_read_timeout 180s;
        proxy_send_timeout 180s;
        proxy_buffering off;
    }
}
