# 現有 VPS：只在既有 Nginx 中增加此 server block，不覆蓋任何舊 80/443 站台。
# 必備：DNS-only A -> 本 VPS；TLS 憑證已存在並可續期；TCP 50000 未被佔用。
# 原版 HALL 8080 是明文 WS，必須對外封鎖。
server {
    listen 50000 ssl;
    server_name v2-hall-direct.myxingbei.com;

    ssl_certificate /etc/letsencrypt/live/v2-hall-direct.myxingbei.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/v2-hall-direct.myxingbei.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    access_log /var/log/nginx/v2-original-hall-access.log combined;
    error_log /var/log/nginx/v2-original-hall-error.log warn;

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        # Required for the separately reviewed proxy-IP HALL candidate.
        # This value is written by trusted Nginx, not copied from client headers.
        proxy_set_header X-V2-Client-IP $remote_addr;
        # Prevent accidental reliance on attacker-supplied forwarding chains.
        proxy_set_header X-Forwarded-For "";

        proxy_connect_timeout 5s;
        proxy_read_timeout 180s;
        proxy_send_timeout 180s;
        proxy_buffering off;
    }
}
