# 新獨立 VPS：安裝時放在 /etc/systemd/system/v2-original-hall.service。
# 操作前建立專用 system user v2hall，確認工作目錄擁有權與 node 可執行路徑。
# 不要用本服務覆寫任何既有 xingbei-hall 或其他版本服務。
[Unit]
Description=V2 original Noname HALL (isolated clean baseline)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=v2hall
Group=v2hall
WorkingDirectory=/opt/v2-original-hall
ExecStart=/usr/bin/node /opt/v2-original-hall/server.js
Restart=on-failure
RestartSec=3
Environment=NODE_ENV=production
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/v2-original-hall
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
